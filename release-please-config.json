{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "initial-version": "0.1.0",
      "package-name": "philcn",
      "changelog-path": "CHANGELOG.md",
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Rewrites" },
        { "type": "docs", "section": "Documentation" },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "Continuous integration", "hidden": true },
        { "type": "chore", "section": "Housekeeping", "hidden": true },
        { "type": "style", "section": "Formatting", "hidden": true }
      ]
    }
  },
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "A new version is ready. Merging this pull request tags it, publishes the changelog, and starts the deployment. Merge it only once the manual test run has passed."
}
