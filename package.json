{
  "name": "philcn",
  "version": "0.2.1",
  "description": "A React component library written from scratch, API-compatible with shadcn/ui.",
  "license": "MIT",
  "author": "Philibert Gentien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilibertG/philcn.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"cli/**/*.test.mjs\"",
    "lint:commits": "node scripts/check-commits.mjs",
    "check": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "bin": {
    "philcn": "cli/index.mjs"
  },
  "files": [
    "cli",
    "!cli/**/*.test.mjs",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "@floating-ui/react-dom": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.0.0"
  }
}
